{
	"extends": "@wordpress/stylelint-config/scss",
	"rules": {
		"selector-class-pattern": [
			"^(flyaffiliate(-[a-z0-9]+)*(__[a-z0-9]+(-[a-z0-9]+)*)?(--[a-z0-9]+(-[a-z0-9]+)*)?|is-[a-z-]+|[a-z][a-z0-9-]*)$",
			{
				"message": "Use flyaffiliate- prefixed BEM class names (block__element--modifier)."
			}
		],
		"at-rule-no-unknown": null,
		"scss/at-rule-no-unknown": [
			true,
			{
				"ignoreAtRules": [
					"source",
					"theme",
					"utility",
					"variant",
					"custom-variant",
					"apply",
					"layer"
				]
			}
		],
		"comment-empty-line-before": [
			"always",
			{
				"except": [
					"first-nested"
				],
				"ignore": [
					"after-comment",
					"stylelint-commands"
				]
			}
		]
	},
	"ignoreFiles": [
		"assets/css/**",
		"build/**",
		"node_modules/**",
		"vendor/**",
		"tests/pw/report/**",
		"tests/pw/test-results/**"
	]
}
