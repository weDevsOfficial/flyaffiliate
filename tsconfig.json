{
	"compilerOptions": {
		"target": "ES2020",
		"lib": [ "DOM", "DOM.Iterable", "ES2020" ],
		"jsx": "react-jsx",
		"module": "ESNext",
		"moduleResolution": "Bundler",
		"strict": true,
		"noEmit": true,
		"esModuleInterop": true,
		"skipLibCheck": true,
		"resolveJsonModule": true,
		"isolatedModules": true,
		"allowJs": true,
		"baseUrl": ".",
		"paths": {
			"@/*": [ "src/admin/*" ]
		}
	},
	"include": [ "src/**/*" ],
	"exclude": [ "node_modules", "assets", "build", "vendor" ]
}
