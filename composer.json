{
    "name": "wedevs/flyaffiliate",
    "description": "Standalone affiliate marketing for WordPress, with optional platform integrations.",
    "type": "wordpress-plugin",
    "license": "GPL-2.0-or-later",
    "authors": [
        {
            "name": "weDevs",
            "email": "support@wedevs.com"
        }
    ],
    "minimum-stability": "dev",
    "prefer-stable": true,
    "require": {
        "php": ">=8.1"
    },
    "require-dev": {
        "appsero/client": "^v2.0.6",
        "brain/monkey": "^2.6",
        "coenjacobs/mozart": "^0.7.1",
        "dealerdirect/phpcodesniffer-composer-installer": "^1.0",
        "mockery/mockery": "^1.6",
        "phpcompatibility/phpcompatibility-wp": "^2.1",
        "phpunit/phpunit": "^9.6",
        "wp-coding-standards/wpcs": "^3.1",
        "wp-phpunit/wp-phpunit": "^6.4",
        "yoast/phpunit-polyfills": "^1.1"
    },
    "config": {
        "platform": {
            "php": "8.1"
        },
        "allow-plugins": {
            "dealerdirect/phpcodesniffer-composer-installer": true
        },
        "platform-check": false,
        "sort-packages": true
    },
    "autoload": {
        "psr-4": {
            "FlyAffiliate\\": "includes/",
            "FlyAffiliate\\Dependencies\\": "vendor-prefixed/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "FlyAffiliate\\Test\\": "tests/php/src/"
        }
    },
    "scripts": {
        "post-install-cmd": [
            "[ $COMPOSER_DEV_MODE -eq 0 ] || \"vendor/bin/mozart\" compose",
            "[ $COMPOSER_DEV_MODE -eq 0 ] || composer dump-autoload"
        ],
        "post-update-cmd": [
            "[ $COMPOSER_DEV_MODE -eq 0 ] || \"vendor/bin/mozart\" compose",
            "[ $COMPOSER_DEV_MODE -eq 0 ] || composer dump-autoload"
        ],
        "phpcs": [
            "phpcs -p -s"
        ],
        "phpcs:report": [
            "phpcs --report-file='phpcs-report.txt'"
        ],
        "phpcbf": [
            "phpcbf -p"
        ],
        "test": [
            "phpunit"
        ],
        "test-f": [
            "phpunit --filter"
        ],
        "release": [
            "@php bin/build-zip.php"
        ]
    },
    "scripts-descriptions": {
        "phpcs": "Run PHP CodeSniffer against the plugin (WordPress-Extra + PHPCompatibilityWP).",
        "phpcbf": "Auto-fix the code style violations PHPCS can fix.",
        "test": "Run the PHPUnit suite (requires a provisioned WP test install or wp-env).",
        "release": "Build build/flyaffiliate-v<version>.zip honouring .distignore."
    },
    "extra": {
        "mozart": {
            "dep_namespace": "FlyAffiliate\\Dependencies\\",
            "dep_directory": "/vendor-prefixed/",
            "classmap_directory": "/vendor-prefixed/classes/",
            "classmap_prefix": "FlyAffiliate_",
            "packages": [
                "appsero/client"
            ],
            "delete_vendor_directories": true
        }
    }
}
